BOT_TOKEN=replace_with_botfather_token
SBER_ONLINE_URL=https://online.sberbank.ru/
# Public HTTPS address of this bot's web server, for example https://bot.example.com
PUBLIC_BASE_URL=
WEB_PORT=8080
# Sber documents this deeplink for Sber ID/SSO flows. Use only as best-effort app launch.
SBER_ANDROID_DEEPLINK=sberbankonline://sberbankid/sso
SBER_IOS_DEEPLINK=sberbankonline://sberbankid/sso
MAX_FILE_SIZE_MB=15
